# ---------------------------------------------------------------------------
# PhishGuard AI - environment configuration
# Copy this file to  server/.env  and fill in what you need.
# The whole app works WITHOUT any keys: the heuristic engine runs offline.
# Keys only switch on the optional LLM explanation layer / threat intel.
# ---------------------------------------------------------------------------

# HTTP port for the Express API
PORT=4000

# Comma separated list of allowed browser origins (Vite dev server default below)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------- AI layer ----------------------------------
# AI_PROVIDER = none | gemini | openai
AI_PROVIDER=none

# Google AI Studio key -> https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (or any OpenAI-compatible endpoint, e.g. Ollama / Groq / OpenRouter)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Weight given to the LLM verdict when fusing with the heuristic score (0..1)
AI_FUSION_WEIGHT=0.35

# Hard timeout for an LLM call in ms (keeps the <5s response-time target)
AI_TIMEOUT_MS=3500

# --------------------------- Threat intelligence ---------------------------
# Optional Google Safe Browsing v4 lookup key. Leave blank to skip.
SAFE_BROWSING_API_KEY=

# Allow the server to fetch a URL's live HTML for website analysis
ENABLE_LIVE_URL_FETCH=true
URL_FETCH_TIMEOUT_MS=6000

# ------------------------------- Storage -----------------------------------
# STORAGE_DRIVER = file | memory | mongo
STORAGE_DRIVER=file
DATA_DIR=./data
MONGODB_URI=

# ------------------------------ Hardening ----------------------------------
# If set, every /api request must send  x-api-key: <value>
API_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
